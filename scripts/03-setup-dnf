#!/usr/bin/env bash
# DNF tuning + optional mirror pinning.
# Usage: ./03-setup-dnf [repo]   (run as root)
#   (no arg)  optimize /etc/dnf/dnf.conf
#   repo      also enable RPM Fusion and pin Fedora/RPM Fusion to the mirror
set -euo pipefail

# Re-run through pkexec when not root (polkit prompt instead of manual sudo)
if [ "$EUID" -ne 0 ]; then
    SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    if command -v pkexec >/dev/null 2>&1; then
        exec pkexec "$SELF" "$@"
    fi
    exec sudo "$SELF" "$@"
fi

. "$(dirname "$0")/common"

FEDORA_MIRROR="${FEDORA_MIRROR:-https://sg.mirrors.cicku.me/fedora/linux}"

if [ ! -f /etc/dnf/dnf.conf ]; then
    color_echo red "-> Error: /etc/dnf/dnf.conf configuration file not found!"
    exit 1
fi

# dnf5-plugins provides copr/config-manager for dnf5 (Fedora 41+)
dnf install -y dnf5-plugins
dnf config-manager setopt max_parallel_downloads=20 timeout=60
color_echo green "-> DNF optimized (max_parallel_downloads=20, timeout=30)"

[ "${1:-}" = "repo" ] || exit 0

# RPM Fusion release packages
dnf install -y 'https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm'
dnf install -y 'https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm'
dnf install -y 'rpmfusion-*-appstream-data'

# Pin Fedora + RPM Fusion repos to the mirror. Fedora 45 ships the repo files
# in /usr/share/dnf5/repos.d and merges /etc/dnf/repos.override.d/*.repo over
# them. An override only changes the keys it names, so commenting out
# `metalink` there does NOT disable the vendor metalink (which wins over
# baseurl, and its mirror list points back at the "fastest" mirror, e.g.
# mirrors.qlu.edu.cn). It has to be set to an empty value instead.
# Seed each override from the vendor file once, then pin it in place.
# To restore stock config: delete /etc/dnf/repos.override.d/*.repo
OVR_DIR=/etc/dnf/repos.override.d
install -d "$OVR_DIR"
shopt -s nullglob
REPO_FILES=(/usr/share/dnf5/repos.d/fedora.repo
            /usr/share/dnf5/repos.d/fedora-updates.repo)
shopt -u nullglob

if ((${#REPO_FILES[@]} == 0)); then
    color_echo yellow "-> Warning: no repo files found, skipping pin"
    exit 0
fi

for repo_file in "${REPO_FILES[@]}"; do
    target="$OVR_DIR/$(basename "$repo_file")"
    [ -f "$target" ] || install -m 0644 "$repo_file" "$target"
    sed -i \
        -e 's!^#\?metalink=.*!metalink=!' \
        -e 's!^#\?mirrorlist=.*!mirrorlist=!' \
        -e 's!^#\?baseurl=!baseurl=!' \
        -e "s!http://download.example/pub/fedora/linux!${FEDORA_MIRROR}!g" \
        "$target"
done
color_echo green "-> Repos pinned via $OVR_DIR (metalink cleared, baseurl -> $FEDORA_MIRROR)"
