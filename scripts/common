# Shared helpers, source from scripts: . "$(dirname "$0")/common"

# Invoking user when run via sudo (falls back to the login user)
ACTUAL_USER="${SUDO_USER:-$(logname 2>/dev/null || true)}"

color_echo() {
    local color="$1" text="$2"
    case "$color" in
        red)    echo -e "\033[0;31m$text\033[0m" ;;
        green)  echo -e "\033[0;32m$text\033[0m" ;;
        yellow) echo -e "\033[1;33m$text\033[0m" ;;
        cyan)   echo -e "\033[0;36m$text\033[0m" ;;
        *)      echo "$text" ;;
    esac
}
